# Copy this file to keystore.properties and fill in your actual keystore details.
# DO NOT commit keystore.properties to version control.

# Generate your release keystore with:
# keytool -genkey -v -keystore release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias vip-life

VIP_LIFE_STORE_FILE=release-key.jks
VIP_LIFE_STORE_PASSWORD=YOUR_STORE_PASSWORD
VIP_LIFE_KEY_ALIAS=vip-life
VIP_LIFE_KEY_PASSWORD=YOUR_KEY_PASSWORD
